{
  "name": "docs-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --import=./scripts/native-json-imports.mjs node_modules/vite/bin/vite.js",
    "build": "node scripts/guard-vocs-config.mjs && pnpm run check:types && pnpm run build:site",
    "build:site": "pnpm run check:styles && vite build && node --experimental-strip-types scripts/finalize-sitemap.ts",
    "check": "biome check --write --unsafe . && pnpm run check:styles",
    "check:anchors": "node --experimental-strip-types scripts/check-internal-anchors.ts",
    "check:markdown": "node scripts/check-markdown-components.mjs && tsx scripts/check-ai-docs.ts",
    "check:types": "tsgo --project tsconfig.app.json --noEmit && tsgo --project tsconfig.node.json --noEmit",
    "preview": "node dist/preview.js",
    "search:benchmark": "bun search-benchmark/run.ts",
    "test": "vitest run --dir src",
    "test:e2e": "playwright test",
    "test:routes-api": "vitest run scripts/routes-api.live.test.ts",
    "test:routing:smoke": "tsx scripts/smoke-docs-routing.ts",
    "bundle:analyze": "node --experimental-strip-types scripts/bundle-diff.ts --skip-build",
    "bundle:diff": "node --experimental-strip-types scripts/bundle-diff.ts",
    "bundle:save": "node --experimental-strip-types scripts/bundle-diff.ts --save",
    "lighthouse": "node --experimental-strip-types scripts/lighthouse.ts",
    "lighthouse:mobile": "node --experimental-strip-types scripts/lighthouse.ts --mobile",
    "og:probe": "node --experimental-strip-types scripts/probe-og.ts",
    "og:goldens": "node scripts/og-goldens.mjs",
    "og:goldens:check": "node scripts/og-goldens.mjs --check",
    "check:styles": "node scripts/check-styles.mjs && oxlint src"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/token-branded": "^1.2.46",
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/rehype": "^4.5.0",
    "@takumi-rs/image-response": "0.62.8",
    "@takumi-rs/wasm": "0.62.8",
    "@tanstack/react-query": "^5.104.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@wagmi/core": "3.6.5",
    "abitype": "^1.3.0",
    "accounts": "0.21.0",
    "hono": "^4.13.13",
    "mermaid": "^11.14.0",
    "minisearch": "7.2.0",
    "monaco-editor": "^0.57.0",
    "ox": "1.8.8",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "prool": "^0.2.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "~19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tapimo": "0.18.2",
    "unified": "^11.0.5",
    "unplugin-icons": "^24.0.0",
    "viem": "2.57.7",
    "viem-zones-sandbox": "npm:viem@2.54.6",
    "vocs": "https://pkg.pr.new/vocs@1c023ba",
    "wagmi": "3.7.7",
    "waku": "1.0.0-rc.3",
    "webauthx": "~0.1.2",
    "zod": "^4.6.7",
    "zyzz": "0.0.36"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "@vitejs/plugin-react": "^6.0.3",
    "anser": "^2.3.5",
    "github-slugger": "2.0.0",
    "mppx": "0.13.3",
    "oxlint": "1.72.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
