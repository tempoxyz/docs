+import type { IrOperation } from './parser.js';
+/** Editable values for one inline playground. Each string uses URL query syntax. */
+export type QueryPreset = {
+    method: string;
+    path: string;
+    /** JSON request body, such as `{"amount":"1000000"}`. */
+    body?: string | undefined;
+    /** Path values, such as `address=0x…`. */
+    params?: string | undefined;
+    /** Query values, such as `chainId=42431`. */
+    query?: string | undefined;
+};
+/** The editable parts of a preset, without the operation it targets. */
+export type Preset = Omit<QueryPreset, 'method' | 'path'>;
+export declare function operationWithPreset(operation: IrOperation, preset?: Preset): IrOperation;
+export declare function operationWithQuery(operation: IrOperation, query?: string): IrOperation;
+export declare function documentWithQuery(document: Record<string, unknown>, preset?: QueryPreset): Record<string, unknown>;
diff --git a/dist/internal/openapi/query-presets.js b/dist/internal/openapi/query-presets.js
