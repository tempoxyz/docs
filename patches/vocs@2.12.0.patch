index 0000000000000000000000000000000000000000..a1b2c16f87ae455f3a011fe305f6b7de1299cd09
--- /dev/null
+++ b/dist/internal/openapi/query-presets.js
@@ -0,0 +1,84 @@
+function hasPreset(preset) {
+    return Boolean(preset?.body || preset?.params || preset?.query);
+}
+function presetValues(preset) {
+    return { path: new URLSearchParams(preset.params), query: new URLSearchParams(preset.query) };
+}
+function presetParameters(parameters, values) {
+    return parameters.map((parameter) => {
+        const source = parameter.in === 'query' ? values.query : parameter.in === 'path' ? values.path : undefined;
+        if (!source || !parameter.name || !source.has(parameter.name))
+            return parameter;
+        const raw = source.get(parameter.name);
+        const value = parameter.schema?.type === 'array' ? raw.split(',') : raw;
+        const { example: _example, ...rest } = parameter;
+        return {
+            ...rest,
+            // Scalar reads parameter examples and needs optional rows explicitly enabled.
+            examples: { default: { value, 'x-disabled': false } },
+            // Vocs generates snippets from schema examples. Neither changes API defaults.
+            schema: { ...parameter.schema, example: value, examples: [value] },
+        };
+    });
+}
+/**
+ * Apply editable path, query, and body examples to one embed without changing its
+ * shared spec. Optional query parameters the preset doesn't name stay out of the sample.
+ */
+// Reject preset names the operation lacks, so a typo or spec rename fails the build.
+function assertKnown(operation, preset, values) {
+    for (const location of ['path', 'query']) {
+        const names = new Set(operation.parameters.filter((parameter) => parameter.in === location).map((parameter) => parameter.name));
+        for (const name of values[location].keys())
+            if (!names.has(name))
+                throw new Error(`OpenAPI operation ${operation.method} ${operation.path} has no ${location} parameter \`${name}\`.`);
+    }
+    if (preset.body && !operation.requestBody)
+        throw new Error(`OpenAPI operation ${operation.method} ${operation.path} has no request body.`);
+}
+export function operationWithPreset(operation, preset) {
+    if (!hasPreset(preset))
+        return operation;
+    const values = presetValues(preset);
+    assertKnown(operation, preset, values);
+    const parameters = presetParameters(operation.parameters, values).filter((parameter) => parameter.in !== 'query' || parameter.required || values.query.has(parameter.name));
+    const { requestBody } = operation;
+    if (!preset.body || !requestBody)
+        return { ...operation, parameters };
+    const example = JSON.parse(preset.body);
+    return {
+        ...operation,
+        parameters,
+        requestBody: {
+            ...requestBody,
+            content: requestBody.content.map((media, index) => (index === 0 ? { ...media, example } : media)),
+        },
+    };
+}
+/** Apply editable query examples to one embed without changing its shared spec. */
+export function operationWithQuery(operation, query) {
+    return operationWithPreset(operation, { query });
+}
+/** Prepare the isolated Scalar document used by this playground instance. */
+export function documentWithQuery(document, preset) {
+    if (!preset || !hasPreset(preset))
+        return document;
+    const copy = structuredClone(document);
+    const paths = copy.paths;
+    const path = paths?.[preset.path];
+    const operation = path?.[preset.method.toLowerCase()];
+    if (!operation)
+        return copy;
+    const values = presetValues(preset);
+    for (const owner of [path, operation]) {
+        if (Array.isArray(owner.parameters))
+            owner.parameters = presetParameters(owner.parameters, values);
+    }
+    const media = operation.requestBody?.content?.['application/json'];
+    if (preset.body && media) {
+        // Scalar fills the request body from the media example before schema examples.
+        delete media.examples;
+        media.example = JSON.parse(preset.body);
+    }
+    return copy;
+}
