@@ -0,0 +1,122 @@
+import type { IrOperation } from './parser.js'
+
+/** Editable values for one inline playground. Each string uses URL query syntax. */
+export type QueryPreset = {
+  method: string
+  path: string
+  /** JSON request body, such as `{"amount":"1000000"}`. */
+  body?: string | undefined
+  /** Path values, such as `address=0x…`. */
+  params?: string | undefined
+  /** Query values, such as `chainId=42431`. */
+  query?: string | undefined
+}
+
+/** The editable parts of a preset, without the operation it targets. */
+export type Preset = Omit<QueryPreset, 'method' | 'path'>
+
+type Parameter = {
+  name?: string
+  in?: string
+  required?: boolean
+  schema?: Record<string, unknown>
+}
+
+type Values = { path: URLSearchParams; query: URLSearchParams }
+
+function hasPreset(preset?: Preset): preset is Preset {
+  return Boolean(preset?.body || preset?.params || preset?.query)
+}
+
+function presetValues(preset: Preset): Values {
+  return { path: new URLSearchParams(preset.params), query: new URLSearchParams(preset.query) }
+}
+
+function presetParameters<T extends Parameter>(parameters: T[], values: Values): T[] {
+  return parameters.map((parameter) => {
+    const source =
+      parameter.in === 'query' ? values.query : parameter.in === 'path' ? values.path : undefined
+    if (!source || !parameter.name || !source.has(parameter.name)) return parameter
+    const raw = source.get(parameter.name)!
+    const value = parameter.schema?.type === 'array' ? raw.split(',') : raw
+    const { example: _example, ...rest } = parameter as T & { example?: unknown }
+    return {
+      ...rest,
+      // Scalar reads parameter examples and needs optional rows explicitly enabled.
+      examples: { default: { value, 'x-disabled': false } },
+      // Vocs generates snippets from schema examples. Neither changes API defaults.
+      schema: { ...parameter.schema, example: value, examples: [value] },
+    } as T
+  })
+}
+
+// Reject preset names the operation lacks, so a typo or spec rename fails the build.
+function assertKnown(operation: IrOperation, preset: Preset, values: Values) {
+  for (const location of ['path', 'query'] as const) {
+    const names = new Set(
+      operation.parameters.filter((parameter) => parameter.in === location).map((parameter) => parameter.name),
+    )
+    for (const name of values[location].keys())
+      if (!names.has(name))
+        throw new Error(`OpenAPI operation ${operation.method} ${operation.path} has no ${location} parameter \`${name}\`.`)
+  }
+  if (preset.body && !operation.requestBody)
+    throw new Error(`OpenAPI operation ${operation.method} ${operation.path} has no request body.`)
+}
+
+/**
+ * Apply editable path, query, and body examples to one embed without changing its
+ * shared spec. Optional query parameters the preset doesn't name stay out of the sample.
+ */
+export function operationWithPreset(operation: IrOperation, preset?: Preset): IrOperation {
+  if (!hasPreset(preset)) return operation
+  const values = presetValues(preset)
+  assertKnown(operation, preset, values)
+  const parameters = presetParameters(operation.parameters, values).filter(
+    (parameter) =>
+      parameter.in !== 'query' || parameter.required || values.query.has(parameter.name),
+  )
+  const { requestBody } = operation
+  if (!preset.body || !requestBody) return { ...operation, parameters }
+  const example = JSON.parse(preset.body) as unknown
+  return {
+    ...operation,
+    parameters,
+    requestBody: {
+      ...requestBody,
+      content: requestBody.content.map((media, index) => (index === 0 ? { ...media, example } : media)),
+    },
+  }
+}
+
+/** Apply editable query examples to one embed without changing its shared spec. */
+export function operationWithQuery(operation: IrOperation, query?: string): IrOperation {
+  return operationWithPreset(operation, { query })
+}
+
+/** Prepare the isolated Scalar document used by this playground instance. */
+export function documentWithQuery(
+  document: Record<string, unknown>,
+  preset?: QueryPreset,
+): Record<string, unknown> {
+  if (!preset || !hasPreset(preset)) return document
+  const copy = structuredClone(document)
+  const paths = copy.paths as Record<string, Record<string, unknown>> | undefined
+  const path = paths?.[preset.path]
+  const operation = path?.[preset.method.toLowerCase()] as Record<string, unknown> | undefined
+  if (!operation) return copy
+  const values = presetValues(preset)
+  for (const owner of [path!, operation]) {
+    if (Array.isArray(owner.parameters))
+      owner.parameters = presetParameters(owner.parameters, values)
+  }
+  const content = (operation.requestBody as { content?: Record<string, Record<string, unknown>> } | undefined)
+    ?.content
+  const media = content?.['application/json']
+  if (preset.body && media) {
+    // Scalar fills the request body from the media example before schema examples.
+    delete media.examples
+    media.example = JSON.parse(preset.body)
+  }
+  return copy
+}
