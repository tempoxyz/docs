diff --git a/src/react/useActiveSidebarAnchor.ts b/src/react/useActiveSidebarAnchor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..33a3e4485f2750e181e5471451f949814d869cc0
--- /dev/null
+++ b/src/react/useActiveSidebarAnchor.ts
@@ -0,0 +1,114 @@
+'use client'
+
+import { useEffect, useMemo, useState } from 'react'
+
+function pathname(value: string) {
+  return value.split(/[?#]/)[0]?.replace(/\/+$/, '') || '/'
+}
+
+function fragment(value: string) {
+  try {
+    return decodeURIComponent(value)
+  } catch {
+    return value
+  }
+}
+
+/** Tracks only sections linked by the current page's sidebar, including their subsections. */
+export function useActiveSidebarAnchor(
+  links: readonly string[],
+  path: string,
+  hash?: string,
+): string | null {
+  const currentPath = pathname(path)
+  const anchorKey = JSON.stringify(
+    links.flatMap((link) => {
+      const [target, id] = link.split('#')
+      return id && pathname(target || currentPath) === currentPath ? [fragment(id)] : []
+    }),
+  )
+  const ids = useMemo<Set<string>>(() => new Set(JSON.parse(anchorKey)), [anchorKey])
+  const [active, setActive] = useState<{ path: string; id: string | null }>({
+    path: currentPath,
+    id: null,
+  })
+
+  useEffect(() => {
+    const updateActive = (id: string | null) =>
+      setActive((previous) =>
+        previous.path === currentPath && previous.id === id ? previous : { path: currentPath, id },
+      )
+    if (!ids.size) {
+      updateActive(null)
+      return
+    }
+
+    let anchors: { element: HTMLElement; margin: number }[] = []
+    let frame = 0
+    const update = () => {
+      frame = 0
+      // Match the browser's anchor offset, including a visible mobile outline.
+      const padding =
+        Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0
+      const outline = document.querySelector<HTMLElement>('[data-v-outline-mobile]')
+      const outlineBottom = outline?.getClientRects().length
+        ? outline.getBoundingClientRect().bottom
+        : 0
+      let id: string | null = null
+      for (const { element, margin } of anchors) {
+        const readingEdge = Math.max(padding + margin, outlineBottom) + 2
+        if (element.getBoundingClientRect().top > readingEdge) break
+        id = element.id
+      }
+      // A short final section may never reach the reading edge.
+      if (
+        window.scrollY > 0 &&
+        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2
+      ) {
+        const last = anchors.at(-1)?.element
+        if (last && last.getBoundingClientRect().top < window.innerHeight) id = last.id
+      }
+      updateActive(id)
+    }
+    const schedule = () => {
+      if (!frame) frame = requestAnimationFrame(update)
+    }
+    const collect = () => {
+      anchors = Array.from(
+        document.querySelectorAll<HTMLElement>(
+          'article[data-v-content] [id], [data-v-openapi] [id]',
+        ),
+      )
+        .filter((element) => ids.has(element.id) && element.getClientRects().length > 0)
+        .map((element) => ({
+          element,
+          margin: Number.parseFloat(getComputedStyle(element).scrollMarginTop) || 0,
+        }))
+      schedule()
+    }
+    collect()
+
+    // Read positions after scroll rather than intersection-entry order. This
+    // works in both directions and when navigation jumps over several headings.
+    window.addEventListener('scroll', schedule, { passive: true })
+    window.addEventListener('resize', collect)
+    window.addEventListener('hashchange', schedule)
+    // Client navigation can replace the article after this effect runs. Observe
+    // its ancestor so asynchronously rendered reference pages are collected too.
+    const mutation = new MutationObserver(collect)
+    mutation.observe(document.body, { childList: true, subtree: true })
+    const resize = new ResizeObserver(schedule)
+    resize.observe(document.documentElement)
+
+    return () => {
+      cancelAnimationFrame(frame)
+      window.removeEventListener('scroll', schedule)
+      window.removeEventListener('resize', collect)
+      window.removeEventListener('hashchange', schedule)
+      mutation.disconnect()
+      resize.disconnect()
+    }
+  }, [currentPath, ids, hash])
+
+  return active.path === currentPath ? active.id : null
+}
