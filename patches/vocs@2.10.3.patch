--- /dev/null
+++ b/src/internal/openapi/query-presets.ts
@@ -0,0 +1,53 @@
+import type { IrOperation } from './parser.js'
+
+export type QueryPreset = { method: string; path: string; query: string }
+
+type Parameter = {
+  name?: string
+  in?: string
+  schema?: Record<string, unknown>
+}
+
+function presetParameters<T extends Parameter>(parameters: T[], query: string): T[] {
+  const values = new URLSearchParams(query)
+  return parameters.map((parameter) => {
+    if (parameter.in !== 'query' || !parameter.name || !values.has(parameter.name))
+      return parameter
+    const raw = values.get(parameter.name)!
+    const value = parameter.schema?.type === 'array' ? raw.split(',') : raw
+    const { example: _example, ...rest } = parameter
+    return {
+      ...rest,
+      // Scalar reads parameter examples and needs optional rows explicitly enabled.
+      examples: { default: { value, 'x-disabled': false } },
+      // Vocs generates snippets from schema examples. Neither changes API defaults.
+      schema: { ...parameter.schema, example: value, examples: [value] },
+    } as T
+  })
+}
+
+/** Apply editable query examples to one embed without changing its shared spec. */
+export function operationWithQuery(operation: IrOperation, query?: string): IrOperation {
+  if (!query) return operation
+  return { ...operation, parameters: presetParameters(operation.parameters, query) }
+}
+
+/** Prepare the isolated Scalar document used by this playground instance. */
+export function documentWithQuery(
+  document: Record<string, unknown>,
+  preset?: QueryPreset,
+): Record<string, unknown> {
+  if (!preset?.query) return document
+  const copy = structuredClone(document)
+  const paths = copy.paths as Record<string, Record<string, unknown>> | undefined
+  const path = paths?.[preset.path]
+  const operation = path?.[preset.method.toLowerCase()] as
+    | Record<string, unknown>
+    | undefined
+  if (!operation) return copy
+  for (const owner of [path!, operation]) {
+    if (Array.isArray(owner.parameters))
+      owner.parameters = presetParameters(owner.parameters, preset.query)
+  }
+  return copy
+}
