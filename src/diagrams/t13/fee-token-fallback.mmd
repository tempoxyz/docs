flowchart LR
  chosen{feeToken, preference, or inferred token?} -- yes --> keep[Pay in that token, unchanged]
  chosen -- no --> path{pathUSD covers the max fee?}
  path -- yes --> pusd[Pay in pathUSD]
  path -- no --> ousd{OUSD covers the max fee?}
  ousd -- yes --> ousdpay[Pay in OUSD, new in T13]
  ousd -- no --> reject[Reject: insufficient funds]
