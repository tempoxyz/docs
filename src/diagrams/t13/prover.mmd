flowchart TB
  subgraph zone[Zone: private execution]
    direction LR
    seq[Zone sequencer] -- 1. batch + state witness --> prover[Nitro prover]
    prover -- 2. signed attestation --> seq
  end
  subgraph tempo[Tempo: public settlement]
    direction LR
    portal[ZonePortal] -- attestation --> verifier[Native verifier]
